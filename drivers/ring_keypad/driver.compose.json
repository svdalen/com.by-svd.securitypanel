    "wakeUpInterval": 0,
    "associationGroups": [
      1
    ],
    "learnmode": {
      "image": "{{driverAssetsPath}}/learnmode.svg",
      "instruction": {
        "en": "1. Power the keypad (USB cable or battery) and make sure it is awake.\n2. Press and hold the 1 key for about three seconds until the keypad's light starts blinking: it is now in pairing mode.\n3. Homey will ask for a 5-digit PIN to pair securely (S2). This is the first five digits of the DSK, printed next to the QR code on the sticker on the back of the keypad (also on the card in the box). Do not enter 00000: that pairs without encryption and the keypad's codes will not work.\n4. Wait until Homey confirms. The keypad resets itself if pairing does not finish within a minute; then start again from step 2."
      }
    },
    "unlearnmode": {
      "image": "{{driverAssetsPath}}/learnmode.svg",
      "instruction": {
        "en": "With the keypad powered, press and hold the 1 key for about three seconds until the light blinks. If Homey does not confirm the removal, use the pinhole reset button on the back of the keypad and let this dialog time out; the keypad can then be added again."
      }
    }
  },
